include README.md
include README.ru.md
include CONCEPT.md
include CONCEPT.ru.md
include CHANGELOG.md
include LICENSE
include pyproject.toml
include pytest.ini
include mypy.ini
include ruff.toml

recursive-include docs *.md
recursive-include Examples *.py
recursive-include Tests *.py

recursive-include Samples/Patterns *.json
recursive-include Samples/Variants/Briefs *.csv *.xls *.xlsx *.json
recursive-include Samples/Variants/Chunks *.csv
recursive-include Samples/Variants/Shorts *.csv *.xls *.xlsx *.json

global-exclude __pycache__/*
global-exclude *.py[cod]
global-exclude .DS_Store
global-exclude *.tmp
prune .agents
prune .git
prune .idea
prune .mypy_cache
prune .pytest_cache
prune .pytest-tmp
prune .ruff_cache
prune build
prune dist
prune Temp
prune zArc
prune Samples/Google
prune Samples/Variants/tmp
